{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "finance-tracker",
    "version": "0.1.0",
    "identifier": "com.maurogonzalez51.finance-tracker",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm generate",
        "devUrl": "http://localhost:3000",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "finance-tracker",
                "width": 1920,
                "height": 1080,
                "decorations": false,
                "closable": true,
                "center": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
